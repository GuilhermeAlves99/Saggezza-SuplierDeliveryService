            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "Month": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "Day": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "DayOfWeek": {
            "$ref": "#/components/schemas/DayOfWeek"
